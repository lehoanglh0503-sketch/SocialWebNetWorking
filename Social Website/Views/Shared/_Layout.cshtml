@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Connectify</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Social_Website.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var userId = Context.Session.GetString("UserId");
        var fullName = Context.Session.GetString("FullName");
        var avatarUrl = Context.Session.GetString("AvatarUrl");
        var username = Context.Session.GetString("Username");
        var isAdmin = Context.Session.GetString("IsAdmin");
    }
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-share-fill me-2"></i>Connectify
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (userId != null)
                        {
                            @if (isAdmin != "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-house-door me-1"></i>Trang chủ
                                    </a>
                                </li>
                            }
                            @if (isAdmin != "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Friend" asp-action="Index">
                                        <i class="bi bi-people me-1"></i>Bạn bè
                                    </a>
                                </li>
                            }
                            @if (isAdmin == "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-semibold" asp-area="" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-lock-fill me-1"></i>Quản trị
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (userId != null)
                        {
                            <div class="dropdown">
                                <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle px-2 py-1 rounded-pill hover-bg-light" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@avatarUrl" alt="@fullName" class="avatar avatar-sm me-2 rounded-circle shadow-sm border border-2 border-white" />
                                    <span class="fw-semibold me-1">@fullName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2 dropdown-user-menu animate-fade-in-up" aria-labelledby="dropdownUser" style="min-width: 250px;">
                                    <li class="px-3 py-2.5 bg-light rounded-3 mb-2 d-flex align-items-center">
                                        <img src="@avatarUrl" alt="@fullName" class="avatar rounded-circle me-2.5 shadow-sm border border-2 border-white" style="width: 40px; height: 40px;" />
                                        <div class="overflow-hidden">
                                            <div class="fw-bold text-dark text-truncate" style="max-width: 150px; font-size: 0.95rem;">@fullName</div>
                                            <div class="text-muted small text-truncate" style="font-size: 0.8rem;">@@@username</div>
                                        </div>
                                        @if (isAdmin == "True")
                                        {
                                            <span class="badge bg-danger text-white rounded-pill ms-auto px-2 py-1 small" style="font-size: 0.68rem;">Admin</span>
                                        }
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 fw-medium text-dark hover-primary-item" asp-controller="Profile" asp-action="Index">
                                            <div class="icon-shape me-2.5 rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 1rem;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <span>Trang cá nhân</span>
                                        </a>
                                    </li>
                                    @if (isAdmin == "True")
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 fw-medium text-danger hover-danger-item" asp-controller="Admin" asp-action="Index">
                                                <div class="icon-shape me-2.5 rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 1rem;">
                                                    <i class="bi bi-shield-lock-fill"></i>
                                                </div>
                                                <span>Trang quản trị</span>
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-2 border-light"></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 fw-medium text-danger hover-danger-item" asp-controller="Auth" asp-action="Logout">
                                            <div class="icon-shape me-2.5 rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 1rem;">
                                                <i class="bi bi-box-arrow-right"></i>
                                            </div>
                                            <span>Đăng xuất</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-link text-decoration-none text-dark fw-semibold me-2" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                            <a class="btn btn-primary" asp-controller="Auth" asp-action="Register">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Floating Button Giới thiệu nhóm (Góc dưới bên phải) -->
    <div class="position-fixed bottom-0 end-0 m-4" style="z-index: 1080;">
        <button type="button" class="btn btn-primary rounded-pill shadow-lg px-4 py-2.5 d-flex align-items-center gap-2.5 fw-bold border-2 border-white animate-fade-in-up hover-lift" data-bs-toggle="modal" data-bs-target="#assignmentModal" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.5) !important;">
            <span class="d-flex align-items-center justify-content-center bg-white text-primary rounded-circle" style="width: 26px; height: 26px;">
                <i class="bi bi-people-fill" style="font-size: 0.85rem;"></i>
            </span>
            <span style="letter-spacing: 0.3px;">Giới thiệu nhóm</span>
        </button>
    </div>

    <!-- Modal Bảng Phân Công Nhiệm Vụ (Thiết kế Card Grid Hiện Đại) -->
    <div class="modal fade" id="assignmentModal" tabindex="-1" aria-labelledby="assignmentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                <!-- Modal Header với Mesh Gradient Sang Trọng -->
                <div class="modal-header text-white p-4 border-0 position-relative" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #2563eb 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-shape bg-white bg-opacity-20 text-white rounded-circle p-2.5 d-flex align-items-center justify-content-center shadow-sm backdrop-blur" style="width: 52px; height: 52px; backdrop-filter: blur(10px);">
                            <i class="bi bi-award-fill fs-3"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-white text-primary rounded-pill px-2.5 py-1 fw-bold small">ĐỒ ÁN LẬP TRÌNH WEB</span>
                                <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-2.5 py-1 small">MẠNG XÃ HỘI CONNECTIFY</span>
                            </div>
                            <h4 class="modal-title fw-extrabold text-white mb-0" id="assignmentModalLabel" style="letter-spacing: -0.5px;">BẢNG PHÂN CÔNG NHIỆM VỤ THỰC HIỆN</h4>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Modal Body với Layout Card 2 Cột Hiện Đại -->
                <div class="modal-body p-4" style="background-color: #f8fafc;">
                    <div class="row g-4">
                        <!-- THÀNH VIÊN 1: LÊ HOÀNG -->
                        <div class="col-lg-6">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover">
                                <!-- Header Thẻ Thành Viên 1 -->
                                <div class="p-3.5 border-bottom bg-white d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-circle-gradient rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 48px; height: 48px; background: linear-gradient(135deg, #4f46e5, #8b5cf6); font-size: 1.1rem;">
                                            LH
                                        </div>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-0">Lê Hoàng</h5>
                                            <span class="text-muted small">Thành viên 1 • Trưởng nhóm / Dev</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fw-bold d-flex align-items-center gap-1">
                                        <i class="bi bi-check-circle-fill"></i> 100% Hoàn thành
                                    </span>
                                </div>
                                <!-- Nội dung Công việc Thành viên 1 -->
                                <div class="card-body p-3.5 bg-white">
                                    <!-- Phần 1: Lập trình Web -->
                                    <div class="p-3 rounded-3 mb-3" style="background-color: #f0f3ff; border-left: 4px solid #4f46e5;">
                                        <h6 class="fw-bold text-primary mb-2 d-flex align-items-center gap-2">
                                            <i class="bi bi-code-slash fs-5"></i> 1. Phát Trẻn Module Web
                                        </h6>
                                        <ul class="mb-0 text-secondary small ps-3 d-flex flex-column gap-1.5" style="line-height: 1.5;">
                                            <li><strong>Thiết kế UI/UX</strong> giao diện Mạng Xã Hội Connectify (Newsfeed, Profile, Auth).</li>
                                            <li><strong>Lập trình Module Bài viết</strong>: Đăng bài kèm ảnh (<code>/uploads/posts/</code>).</li>
                                            <li><strong>Thả cảm xúc 6 loại</strong> (Like, Love, Haha, Wow, Sad, Angry) &amp; Bình luận lồng nhau.</li>
                                        </ul>
                                    </div>

                                    <!-- Phần 2: Báo cáo & Sơ đồ -->
                                    <div class="p-3 rounded-3" style="background-color: #f0fdf4; border-left: 4px solid #16a34a;">
                                        <h6 class="fw-bold text-success mb-2 d-flex align-items-center gap-2">
                                            <i class="bi bi-file-earmark-bar-graph fs-5"></i> 2. Biên Soạn Báo Cáo &amp; Sơ Đồ
                                        </h6>
                                        <ul class="mb-0 text-secondary small ps-3 d-flex flex-column gap-1.5" style="line-height: 1.5;">
                                            <li>Biên soạn báo cáo tổng hợp dự án.</li>
                                            <li>Thiết kế Sơ đồ luồng dữ liệu <strong>DFD Mức 0, 1, 2</strong>.</li>
                                            <li>Sơ đồ <strong>Use Case</strong> (1-include 1-extend), 16 Đặc tả Use Case &amp; Deployment Diagram.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- THÀNH VIÊN 2: PHẠM TẤN TÀI -->
                        <div class="col-lg-6">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover">
                                <!-- Header Thẻ Thành Viên 2 -->
                                <div class="p-3.5 border-bottom bg-white d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-circle-gradient rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 48px; height: 48px; background: linear-gradient(135deg, #06b6d4, #3b82f6); font-size: 1.1rem;">
                                            TT
                                        </div>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-0">Phạm Tấn Tài</h5>
                                            <span class="text-muted small">Thành viên 2 • Backend / Database</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fw-bold d-flex align-items-center gap-1">
                                        <i class="bi bi-check-circle-fill"></i> 100% Hoàn thành
                                    </span>
                                </div>
                                <!-- Nội dung Công việc Thành viên 2 -->
                                <div class="card-body p-3.5 bg-white">
                                    <!-- Phần 1: Lập trình Web -->
                                    <div class="p-3 rounded-3 mb-3" style="background-color: #ecfeff; border-left: 4px solid #0891b2;">
                                        <h6 class="fw-bold text-info mb-2 d-flex align-items-center gap-2" style="color: #0891b2 !important;">
                                            <i class="bi bi-cpu fs-5"></i> 1. Phát Trẻn Module Web &amp; Realtime
                                        </h6>
                                        <ul class="mb-0 text-secondary small ps-3 d-flex flex-column gap-1.5" style="line-height: 1.5;">
                                            <li><strong>Module Kết nối bạn bè</strong> (Friendships), Gợi ý kết bạn.</li>
                                            <li><strong>Nhắn tin trò chuyện 1-1</strong> real-time qua SignalR <code>ChatHub</code>.</li>
                                            <li><strong>Trang Admin Dashboard</strong>: Thống kê 4 chỉ số, Reset pass, Xóa user Cascade Clean, Duyệt PostReports &amp; BannedWords.</li>
                                        </ul>
                                    </div>

                                    <!-- Phần 2: Báo cáo & Sơ đồ -->
                                    <div class="p-3 rounded-3" style="background-color: #f0fdf4; border-left: 4px solid #16a34a;">
                                        <h6 class="fw-bold text-success mb-2 d-flex align-items-center gap-2">
                                            <i class="bi bi-diagram-3 fs-5"></i> 2. Biên Soạn Báo Cáo &amp; Sơ Đồ
                                        </h6>
                                        <ul class="mb-0 text-secondary small ps-3 d-flex flex-column gap-1.5" style="line-height: 1.5;">
                                            <li>Vẽ Sơ đồ Trạng thái (State Diagram).</li>
                                            <li>Sơ đồ Hoạt động Swimlane (Activity Diagram).</li>
                                            <li>Sơ đồ Thực thể <strong>ERD 9 bảng</strong> &amp; Sơ đồ Logic CSDL.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-white p-3.5 border-0 justify-content-between">
                    <div class="d-flex align-items-center gap-2 text-muted small">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>Đồ Án Mạng Xã Hội Connectify &copy; 2026 • Đã hoàn thành 100% yêu cầu</span>
                    </div>
                    <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold" data-bs-dismiss="modal">Đóng cửa sổ</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
