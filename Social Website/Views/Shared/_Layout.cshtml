@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Connectify</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Social_Website.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var userId = Context.Session.GetString("UserId");
        var fullName = Context.Session.GetString("FullName");
        var avatarUrl = Context.Session.GetString("AvatarUrl");
        var username = Context.Session.GetString("Username");
        var isAdmin = Context.Session.GetString("IsAdmin");
    }
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-share-fill me-2"></i>Connectify
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (userId != null)
                        {
                            @if (isAdmin != "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-house-door me-1"></i>Trang chủ
                                    </a>
                                </li>
                            }
                            @if (isAdmin != "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Friend" asp-action="Index">
                                        <i class="bi bi-people me-1"></i>Bạn bè
                                    </a>
                                </li>
                            }
                            @if (isAdmin == "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-semibold" asp-area="" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-lock-fill me-1"></i>Quản trị
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (userId != null)
                        {
                            <div class="dropdown">
                                <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle px-2 py-1 rounded-pill hover-bg-light" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@avatarUrl" alt="@fullName" class="avatar avatar-sm me-2 rounded-circle shadow-sm border border-2 border-white" />
                                    <span class="fw-semibold me-1">@fullName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2 dropdown-user-menu animate-fade-in-up" aria-labelledby="dropdownUser" style="min-width: 250px;">
                                    <li class="px-3 py-2.5 bg-light rounded-3 mb-2 d-flex align-items-center">
                                        <img src="@avatarUrl" alt="@fullName" class="avatar rounded-circle me-2.5 shadow-sm border border-2 border-white" style="width: 40px; height: 40px;" />
                                        <div class="overflow-hidden">
                                            <div class="fw-bold text-dark text-truncate" style="max-width: 150px; font-size: 0.95rem;">@fullName</div>
                                            <div class="text-muted small text-truncate" style="font-size: 0.8rem;">@@@username</div>
                                        </div>
                                        @if (isAdmin == "True")
                                        {
                                            <span class="badge bg-danger text-white rounded-pill ms-auto px-2 py-1 small" style="font-size: 0.68rem;">Admin</span>
                                        }
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 fw-medium text-dark hover-primary-item" asp-controller="Profile" asp-action="Index">
                                            <div class="icon-shape me-2.5 rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 1rem;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <span>Trang cá nhân</span>
                                        </a>
                                    </li>
                                    @if (isAdmin == "True")
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 fw-medium text-danger hover-danger-item" asp-controller="Admin" asp-action="Index">
                                                <div class="icon-shape me-2.5 rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 1rem;">
                                                    <i class="bi bi-shield-lock-fill"></i>
                                                </div>
                                                <span>Trang quản trị</span>
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-2 border-light"></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 fw-medium text-danger hover-danger-item" asp-controller="Auth" asp-action="Logout">
                                            <div class="icon-shape me-2.5 rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 1rem;">
                                                <i class="bi bi-box-arrow-right"></i>
                                            </div>
                                            <span>Đăng xuất</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-link text-decoration-none text-dark fw-semibold me-2" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                            <a class="btn btn-primary" asp-controller="Auth" asp-action="Register">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Floating Button Giới thiệu nhóm (Đơn giản, gọn gàng) -->
    <div class="position-fixed bottom-0 end-0 m-4" style="z-index: 1080;">
        <button type="button" class="btn btn-dark rounded-pill shadow px-3.5 py-2 d-flex align-items-center gap-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#assignmentModal">
            <i class="bi bi-info-circle"></i>
            <span>Giới thiệu nhóm</span>
        </button>
    </div>

    <!-- Modal Bảng Phân Công Nhiệm Vụ (Đơn giản, Gọn gàng) -->
    <div class="modal fade" id="assignmentModal" tabindex="-1" aria-labelledby="assignmentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <!-- Header đơn giản -->
                <div class="modal-header bg-light border-bottom p-3">
                    <h5 class="modal-title fw-bold text-dark mb-0" id="assignmentModalLabel">
                        <i class="bi bi-people-fill me-2 text-primary"></i>BẢNG PHÂN CÔNG NHIỆM VỤ
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <!-- Body dạng bảng Bootstrap đơn giản -->
                <div class="modal-body p-3">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0" style="font-size: 0.92rem;">
                            <thead class="table-light text-center fw-bold">
                                <tr>
                                    <th style="width: 20%;">Tên thành viên</th>
                                    <th style="width: 68%;">Nhiệm vụ phân công</th>
                                    <th style="width: 12%;">Mức độ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Thành viên 1: Lê Hoàng -->
                                <tr>
                                    <td class="fw-bold text-center bg-light">Lê Hoàng</td>
                                    <td>
                                        <div class="mb-2">
                                            <strong class="text-primary">• Web:</strong> Thiết kế UI/UX giao diện Mạng Xã Hội Connectify (Newsfeed, Profile, Auth); Lập trình Module Bài viết, Đăng bài kèm ảnh (/uploads/posts/), Thả cảm xúc 6 loại (Like/Love/Haha...) &amp; Bình luận lồng nhau.
                                        </div>
                                        <div>
                                            <strong class="text-success">• Báo cáo:</strong> Biên soạn báo cáo tổng hợp, thiết kế Sơ đồ luồng dữ liệu DFD Mức 0, 1, 2, Sơ đồ Use Case (1-include 1-extend), 16 Đặc tả Use Case &amp; Deployment Diagram.
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold text-success">100%</td>
                                </tr>
                                
                                <!-- Thành viên 2: Phạm Tấn Tài -->
                                <tr>
                                    <td class="fw-bold text-center bg-light">Phạm Tấn Tài</td>
                                    <td>
                                        <div class="mb-2">
                                            <strong class="text-primary">• Web:</strong> Lập trình Module Kết nối bạn bè (Friendships), Gợi ý kết bạn &amp; Nhắn tin trò chuyện 1-1 real-time qua SignalR ChatHub; Lập trình Trang Admin Dashboard (Thống kê 4 chỉ số, Reset pass, Xóa user Cascade Clean, Duyệt PostReports &amp; BannedWords).
                                        </div>
                                        <div>
                                            <strong class="text-success">• Báo cáo:</strong> Vẽ Sơ đồ Trạng thái (State Diagram), Sơ đồ Hoạt động Swimlane (Activity Diagram), Sơ đồ Thực thể ERD 9 bảng &amp; Sơ đồ Logic CSDL.
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold text-success">100%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footer đơn giản -->
                <div class="modal-footer bg-light border-top p-2 justify-content-end">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
