@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Connectify</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Social_Website.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var userId = Context.Session.GetString("UserId");
        var fullName = Context.Session.GetString("FullName");
        var avatarUrl = Context.Session.GetString("AvatarUrl");
        var username = Context.Session.GetString("Username");
        var isAdmin = Context.Session.GetString("IsAdmin");
    }
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-share-fill me-2"></i>Connectify
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (userId != null)
                        {
                            @if (isAdmin != "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-house-door me-1"></i>Trang chủ
                                    </a>
                                </li>
                            }
                            @if (isAdmin != "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Friend" asp-action="Index">
                                        <i class="bi bi-people me-1"></i>Bạn bè
                                    </a>
                                </li>
                            }
                            @if (isAdmin == "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-semibold" asp-area="" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-lock-fill me-1"></i>Quản trị
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (userId != null)
                        {
                            <div class="dropdown">
                                <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle px-2 py-1 rounded-pill hover-bg-light" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@avatarUrl" alt="@fullName" class="avatar avatar-sm me-2 rounded-circle shadow-sm border border-2 border-white" />
                                    <span class="fw-semibold me-1">@fullName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2 dropdown-user-menu animate-fade-in-up" aria-labelledby="dropdownUser" style="min-width: 250px;">
                                    <li class="px-3 py-2.5 bg-light rounded-3 mb-2 d-flex align-items-center">
                                        <img src="@avatarUrl" alt="@fullName" class="avatar rounded-circle me-2.5 shadow-sm border border-2 border-white" style="width: 40px; height: 40px;" />
                                        <div class="overflow-hidden">
                                            <div class="fw-bold text-dark text-truncate" style="max-width: 150px; font-size: 0.95rem;">@fullName</div>
                                            <div class="text-muted small text-truncate" style="font-size: 0.8rem;">@@@username</div>
                                        </div>
                                        @if (isAdmin == "True")
                                        {
                                            <span class="badge bg-danger text-white rounded-pill ms-auto px-2 py-1 small" style="font-size: 0.68rem;">Admin</span>
                                        }
                                    </li>
                                    @if (isAdmin != "True")
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 fw-medium text-dark hover-primary-item" asp-controller="Profile" asp-action="Index">
                                                <div class="icon-shape me-2.5 rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 1rem;">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                                <span>Trang cá nhân</span>
                                            </a>
                                        </li>
                                    }
                                    @if (isAdmin == "True")
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 fw-medium text-danger hover-danger-item" asp-controller="Admin" asp-action="Index">
                                                <div class="icon-shape me-2.5 rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 1rem;">
                                                    <i class="bi bi-shield-lock-fill"></i>
                                                </div>
                                                <span>Trang quản trị</span>
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-2 border-light"></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 fw-medium text-danger hover-danger-item" asp-controller="Auth" asp-action="Logout">
                                            <div class="icon-shape me-2.5 rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 1rem;">
                                                <i class="bi bi-box-arrow-right"></i>
                                            </div>
                                            <span>Đăng xuất</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-link text-decoration-none text-dark fw-semibold me-2" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                            <a class="btn btn-primary" asp-controller="Auth" asp-action="Register">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    @if (TempData["AccountWarning"] != null)
    {
        <!-- Modal Cảnh báo Vi phạm Tài khoản (khi bị 2 lần duyệt báo cáo) -->
        <div class="modal fade" id="accountWarningModal" tabindex="-1" aria-labelledby="accountWarningModalLabel" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header bg-warning bg-opacity-10 border-bottom-0 py-3" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <h5 class="modal-title fw-bold text-warning-emphasis d-flex align-items-center mb-0" id="accountWarningModalLabel">
                            <i class="bi bi-exclamation-triangle-fill text-warning fs-3 me-2"></i>CẢNH BÁO VI PHẠM TÀI KHOẢN
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4 text-center">
                        <div class="mb-3 text-warning">
                            <i class="bi bi-shield-exclamation display-1"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Tài khoản của bạn đã vi phạm 2 lần!</h5>
                        <div class="alert alert-warning border-warning-subtle text-dark text-start small mb-0 rounded-3 p-3">
                            <i class="bi bi-info-circle-fill text-warning me-1.5"></i>
                            @TempData["AccountWarning"]
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 justify-content-center pb-4">
                        <button type="button" class="btn btn-warning px-5 rounded-pill fw-bold text-dark shadow-sm" data-bs-dismiss="modal">
                            <i class="bi bi-check2-circle me-1"></i>Tôi đã hiểu và cam kết tuân thủ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (TempData["AccountWarning"] != null)
    {
        <script>
            $(document).ready(function () {
                var warningModalEl = document.getElementById('accountWarningModal');
                if (warningModalEl) {
                    var warningModal = new bootstrap.Modal(warningModalEl);
                    warningModal.show();
                }
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
