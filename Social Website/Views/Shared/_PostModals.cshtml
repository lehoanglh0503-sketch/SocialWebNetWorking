<!-- Modal Báo cáo bài viết (M04) -->
<div class="modal fade" id="reportPostModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="reportModalLabel"><i class="bi bi-flag-fill text-warning me-2"></i>Báo cáo bài viết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="reportPostForm">
                <div class="modal-body py-3">
                    <input type="hidden" id="reportPostId" name="postId" />
                    <div id="reportAlertBox" class="alert alert-danger d-none py-2 px-3 small mb-3"></div>
                    <div class="mb-3">
                        <label for="reportReason" class="form-label fw-semibold small">Lý do báo cáo vi phạm:</label>
                        <select class="form-select form-control-modern" id="reportReason" required>
                            <option value="" disabled selected>-- Chọn lý do --</option>
                            <option value="Spam / Quảng cáo trái phép">Spam / Quảng cáo trái phép</option>
                            <option value="Ngôn từ kích động thù địch / Nhạy cảm">Ngôn từ kích động thù địch / Nhạy cảm</option>
                            <option value="Quấy rối / Đe dọa">Quấy rối / Đe dọa</option>
                            <option value="Nội dung sai lệch / Lừa đảo">Nội dung sai lệch / Lừa đảo</option>
                            <option value="Lý do khác">Lý do khác...</option>
                        </select>
                    </div>
                    <div class="mb-3 d-none" id="otherReasonWrapper">
                        <label for="otherReason" class="form-label fw-semibold small">Chi tiết lý do khác:</label>
                        <textarea class="form-control form-control-modern" id="otherReason" rows="3" placeholder="Nhập lý do chi tiết (không quá 500 ký tự)..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 btn-submit-report">Gửi báo cáo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chi tiết cảm xúc -->
<div class="modal fade" id="reactionsDetailModal" tabindex="-1" aria-labelledby="reactionsDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom-0 pb-2 pt-4 px-4 shadow-sm">
                <h6 class="modal-title fw-bold text-primary" id="reactionsDetailModalLabel"><i class="bi bi-heart-fill text-danger me-2"></i>Người đã tương tác</h6>
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-2 px-4" style="max-height: 380px; overflow-y: auto;" id="reactionsModalBody">
                <!-- Danh sách người tương tác sẽ hiển thị ở đây -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết cảm xúc Bình luận -->
<div class="modal fade" id="commentReactionsDetailModal" tabindex="-1" aria-labelledby="commentReactionsDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom-0 pb-2 pt-4 px-4 shadow-sm">
                <h6 class="modal-title fw-bold text-primary" id="commentReactionsDetailModalLabel"><i class="bi bi-heart-fill text-danger me-2"></i>Người đã thả cảm xúc bình luận</h6>
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-2 px-4" style="max-height: 380px; overflow-y: auto;" id="commentReactionsModalBody">
                <!-- Danh sách người tương tác bình luận sẽ hiển thị ở đây -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Chia sẻ bài viết qua tin nhắn -->
<div class="modal fade" id="sharePostModal" tabindex="-1" aria-labelledby="sharePostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom-0 pb-2 pt-4 px-4 shadow-sm">
                <h6 class="modal-title fw-bold text-primary" id="sharePostModalLabel"><i class="bi bi-share-fill me-2"></i>Chia sẻ bài viết qua tin nhắn</h6>
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="sharePostId" />
                <!-- Xem trước bài viết được chia sẻ -->
                <div class="card bg-light border mb-3 rounded-3 p-3" id="sharePostPreview">
                    <div class="d-flex align-items-center mb-2">
                        <img src="" id="sharePostAuthorAvatar" class="avatar avatar-sm me-2 rounded-circle" style="width: 32px; height: 32px;" />
                        <div>
                            <div class="fw-bold small text-dark" id="sharePostAuthorName">Tác giả</div>
                            <div class="text-muted extra-small" style="font-size: 0.7rem;">Bài viết chia sẻ</div>
                        </div>
                    </div>
                    <p class="card-text small text-dark mb-2" id="sharePostSnippet" style="white-space: pre-wrap; max-height: 80px; overflow: hidden; text-overflow: ellipsis;"></p>
                    <div id="sharePostImageWrapper" class="d-none text-center">
                        <img src="" id="sharePostImagePreview" class="img-fluid rounded" style="max-height: 140px; object-fit: cover;" />
                    </div>
                </div>

                <!-- Ô nhập lời nhắn -->
                <div class="mb-3">
                    <label for="shareCustomMessage" class="form-label small fw-semibold">Lời nhắn kèm theo (tùy chọn):</label>
                    <textarea id="shareCustomMessage" class="form-control form-control-sm" rows="2" placeholder="Hãy xem bài viết này nè..."></textarea>
                </div>

                <!-- Danh sách bạn bè để chia sẻ -->
                <label class="form-label small fw-semibold">Gửi cho bạn bè:</label>
                <div id="shareFriendsList" class="d-flex flex-column gap-2" style="max-height: 220px; overflow-y: auto;">
                    <div class="text-center py-3 text-muted small"><span class="spinner-border spinner-border-sm me-1"></span> Đang tải bạn bè...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hộp thoại Chat nổi -->
<div id="chatBox" class="card position-fixed border-0 shadow-lg d-none animate-fade-in-up" style="bottom: 0; right: 80px; width: 340px; z-index: 1040; border-radius: 16px 16px 0 0; transition: all 0.3s ease;">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2 px-3" style="border-top-left-radius: 16px; border-top-right-radius: 16px; cursor: pointer;" onclick="toggleMinimizeChat()">
        <div class="d-flex align-items-center">
            <img src="" id="chatFriendAvatar" class="avatar avatar-sm me-2 border border-white" style="width: 30px; height: 30px;" />
            <div>
                <div class="fw-bold small" id="chatFriendName" style="line-height: 1.2; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Name</div>
                <span class="text-white-50" style="font-size: 0.65rem;">Bạn bè</span>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center" onclick="event.stopPropagation();">
            <button type="button" class="btn btn-link text-white p-0" onclick="toggleMinimizeChat()"><i class="bi bi-dash-lg" id="minimizeChatIcon"></i></button>
            <button type="button" class="btn-close btn-close-white btn-sm" onclick="closeChatBox()"></button>
        </div>
    </div>
    <div id="chatBoxCollapse" class="collapse show">
        <div class="card-body p-3 bg-light" id="chatMessageList" style="height: 280px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px;">
            <!-- Tin nhắn hiển thị ở đây -->
        </div>
        <div class="card-footer bg-white border-top p-2">
            <div id="chatImagePreviewContainer" class="d-none mb-2 position-relative d-inline-block">
                <img id="chatImagePreview" src="" class="img-thumbnail rounded shadow-sm" style="max-height: 80px; max-width: 120px; object-fit: cover;" />
                <button type="button" id="btnRemoveChatImage" class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 p-0 shadow" style="width: 22px; height: 22px; line-height: 1; transform: translate(30%, -30%);">&times;</button>
            </div>
            <form id="chatForm">
                <input type="hidden" id="chatFriendId" />
                <input type="file" id="chatImageInput" accept="image/*" class="d-none" />
                <div class="input-group">
                    <label for="chatImageInput" class="btn btn-light btn-sm border text-primary d-flex align-items-center justify-content-center px-2 cursor-pointer" title="Gửi hình ảnh" style="border-radius: 20px 0 0 20px;">
                        <i class="bi bi-image fs-6"></i>
                    </label>
                    <input type="text" id="chatInput" class="form-control form-control-sm form-control-modern" placeholder="Nhập tin nhắn..." autocomplete="off" style="border-radius: 0;" />
                    <button type="submit" class="btn btn-primary btn-sm px-3" style="border-radius: 0 20px 20px 0;"><i class="bi bi-send-fill"></i></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa bài viết (M05) -->
<div class="modal fade" id="editPostModal" tabindex="-1" aria-labelledby="editPostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="editPostModalLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa bài viết
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editPostForm">
                    <input type="hidden" id="editPostId" name="postId" />
                    
                    <div class="mb-3">
                        <label for="editPostContent" class="form-label fw-semibold text-muted small">Nội dung bài viết</label>
                        <textarea id="editPostContent" name="content" class="form-control" rows="4" placeholder="Nhập nội dung bài viết mới..."></textarea>
                    </div>

                    <div id="editPostAlert" class="alert alert-danger d-none mb-3" style="border-radius: 12px; font-size: 0.85rem;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span id="editPostAlertMsg"></span>
                    </div>

                    <div id="editPostImagePreviewArea" class="d-none mb-3 p-3 bg-light rounded-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-semibold small text-dark"><i class="bi bi-image me-1"></i>Ảnh hiện tại:</span>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="editRemoveImage" name="removeImage" />
                                <label class="form-check-label small text-danger fw-semibold" for="editRemoveImage">Bỏ ảnh này</label>
                            </div>
                        </div>
                        <div class="text-center">
                            <img id="editPostImagePreview" src="" class="img-fluid rounded shadow-sm" style="max-height: 200px;" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" id="btnSaveEditPost">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
