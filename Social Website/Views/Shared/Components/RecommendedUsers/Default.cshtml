@model IEnumerable<Social_Website.Models.User>

<div class="card">
    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
        <h6 class="fw-bold mb-0 text-primary">Gợi ý kết bạn</h6>
    </div>
    <div class="card-body px-4 pb-4 pt-2">
        <div class="d-flex flex-column gap-3">
            @if (Model != null && Model.Any())
            {
                foreach (var user in Model)
                {
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <img src="@user.AvatarUrl" alt="@user.FullName" class="avatar avatar-sm me-2.5" />
                            <div>
                                <h6 class="fw-semibold mb-0 small text-truncate" style="max-width: 100px;">@user.FullName</h6>
                                <span class="text-muted small" style="font-size: 0.75rem;">@@@user.Username</span>
                            </div>
                        </div>
                        <button class="btn btn-primary btn-sm py-1 px-3 btn-add-friend" data-user-id="@user.UserId" style="font-size: 0.8rem;">
                            <i class="bi bi-person-plus-fill me-1"></i>Thêm
                        </button>
                    </div>
                }
            }
            else
            {
                <p class="text-muted small mb-0">Không có gợi ý mới.</p>
            }
        </div>
    </div>
</div>
