@using Social_Website.Helpers
@model Social_Website.Models.ProfileViewModel
@{
    ViewData["Title"] = $"Hồ sơ của {Model.User.FullName}";
    Layout = "_Layout";
    var currentUser = ViewBag.CurrentUser as Social_Website.Models.User;
}

<style>
    .profile-card {
        border-radius: var(--border-radius, 16px);
        background: var(--bg-card, #ffffff);
        border: 1px solid var(--border-color, #e2e8f0);
        box-shadow: var(--glass-shadow, 0 4px 20px rgba(0,0,0,0.05));
        overflow: hidden;
    }
    
    .profile-header-bg {
        height: 140px;
        background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%);
    }

    .avatar-wrapper {
        position: relative;
        width: 110px;
        height: 110px;
        margin-top: -55px;
        margin-left: auto;
        margin-right: auto;
        border-radius: 50%;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .avatar-wrapper .avatar-img {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #ffffff;
        background-color: var(--primary-light, #f0fdf4);
    }

    .stat-box {
        border-radius: 12px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .stat-box:hover {
        background-color: #e0e7ff;
        color: #4f46e5 !important;
        transform: translateY(-2px);
    }

    .stat-box i {
        font-size: 1.5rem;
    }

    .form-section-title {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--text-main);
        border-bottom: 2px solid var(--primary-light);
        padding-bottom: 0.5rem;
    }
</style>

<div class="row py-3 animate-fade-in-up">
    <!-- Cột bên trái: Thông tin cá nhân & Thống kê (Sticky) -->
    <div class="col-12 col-lg-4 mb-4">
        <div class="profile-card text-center pb-4 profile-sticky-card">
            <div class="profile-header-bg"></div>
            
            <div class="avatar-wrapper">
                <img src="@Model.User.AvatarUrl" alt="@Model.User.FullName" class="avatar-img" />
            </div>
            
            <h4 class="fw-bold mt-3 mb-1 text-dark">@Model.User.FullName</h4>
            <p class="text-muted small mb-3">@@@Model.User.Username</p>
            
            <!-- Trạng thái kết bạn & Nhắn tin -->
            <div class="d-flex justify-content-center gap-2 mb-4 px-3" id="friendActionWrapper">
                @if (Model.FriendshipStatus == "Friends")
                {
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 btn-remove-friend-action" data-user-id="@Model.User.UserId">
                        <i class="bi bi-person-check-fill me-1"></i>Bạn bè
                    </button>
                    <button class="btn btn-primary btn-sm rounded-pill px-3 py-1.5 btn-open-chat" data-friend-id="@Model.User.UserId" data-friend-name="@Model.User.FullName" data-friend-avatar="@Model.User.AvatarUrl">
                        <i class="bi bi-chat-dots-fill me-1"></i>Nhắn tin
                    </button>
                }
                else if (Model.FriendshipStatus == "PendingSent")
                {
                    <button class="btn btn-secondary btn-sm rounded-pill px-3 py-1.5 btn-remove-friend-action" data-user-id="@Model.User.UserId">
                        <i class="bi bi-person-dash me-1"></i>Hủy lời mời
                    </button>
                }
                else if (Model.FriendshipStatus == "PendingReceived")
                {
                    <button class="btn btn-success btn-sm rounded-pill px-3 py-1.5 btn-accept-friend-action" data-user-id="@Model.User.UserId">
                        <i class="bi bi-person-plus-fill me-1"></i>Chấp nhận
                    </button>
                }
                else
                {
                    <button class="btn btn-primary btn-sm rounded-pill px-3 py-1.5 btn-add-friend-action" data-user-id="@Model.User.UserId">
                        <i class="bi bi-person-plus-fill me-1"></i>Thêm bạn bè
                    </button>
                }
            </div>
            
            <!-- 3 ô thống kê (Bài đăng, Bình luận, Bạn bè) -->
            <div class="px-4">
                <div class="row g-2">
                    <div class="col-4">
                        <div class="stat-box p-3 text-secondary text-decoration-none d-block" onclick="activateOtherTab('other-posts-nav')">
                            <i class="bi bi-chat-left-text-fill text-success"></i>
                            <div class="fw-bold text-dark mt-1">@Model.TotalPosts</div>
                            <div class="text-muted" style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase;">Bài đăng</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box p-3 text-secondary text-decoration-none d-block" onclick="activateOtherTab('other-about-nav')">
                            <i class="bi bi-chat-dots-fill text-primary"></i>
                            <div class="fw-bold text-dark mt-1">@Model.TotalComments</div>
                            <div class="text-muted" style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase;">Bình luận</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box p-3 text-secondary text-decoration-none d-block" onclick="activateOtherTab('other-friends-nav')">
                            <i class="bi bi-people-fill text-warning"></i>
                            <div class="fw-bold text-dark mt-1">@Model.TotalFriends</div>
                            <div class="text-muted" style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase;">Bạn bè</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột bên phải: Tabs (Bài viết, Giới thiệu, Bạn bè) -->
    <div class="col-12 col-lg-8">
        <!-- Navigation Pills -->
        <ul class="nav nav-pills profile-nav-pills bg-white p-2 rounded-4 shadow-sm border mb-4 gap-1 flex-nowrap overflow-auto" id="otherProfileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active d-flex align-items-center" id="other-posts-nav" data-bs-toggle="pill" data-bs-target="#other-posts" type="button" role="tab" aria-controls="other-posts" aria-selected="true">
                    <i class="bi bi-grid-3x3 me-2"></i>
                    <span>Bài viết</span>
                    <span class="badge bg-primary-subtle text-primary ms-2 rounded-pill px-2">@Model.TotalPosts</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link d-flex align-items-center" id="other-about-nav" data-bs-toggle="pill" data-bs-target="#other-about" type="button" role="tab" aria-controls="other-about" aria-selected="false">
                    <i class="bi bi-info-circle me-2"></i>
                    <span>Giới thiệu</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link d-flex align-items-center" id="other-friends-nav" data-bs-toggle="pill" data-bs-target="#other-friends" type="button" role="tab" aria-controls="other-friends" aria-selected="false">
                    <i class="bi bi-people-fill me-2"></i>
                    <span>Bạn bè</span>
                    <span class="badge bg-warning-subtle text-warning-emphasis ms-2 rounded-pill px-2">@Model.TotalFriends</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="otherProfileTabContent">
            <!-- TAB 1: BÀI VIẾT (FULL INTERACTIVE POSTS) -->
            <div class="tab-pane fade show active" id="other-posts" role="tabpanel" aria-labelledby="other-posts-nav">
                @if (Model.Posts != null && Model.Posts.Any())
                {
                    <div id="otherUserPostsList">
                        @foreach (var post in Model.Posts)
                        {
                            <partial name="_PostCard" model="post" />
                        }
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm text-center py-5 rounded-4 mb-4">
                        <div class="card-body">
                            <i class="bi bi-file-earmark-x display-2 text-muted opacity-50 mb-3 d-block"></i>
                            <h5 class="fw-bold text-dark">Chưa có bài viết nào</h5>
                            <p class="text-muted small">@Model.User.FullName chưa chia sẻ bài viết nào.</p>
                        </div>
                    </div>
                }
            </div>

            <!-- TAB 2: GIỚI THIỆU -->
            <div class="tab-pane fade" id="other-about" role="tabpanel" aria-labelledby="other-about-nav">
                <div class="profile-card p-4 mb-4">
                    <h5 class="form-section-title mb-4"><i class="bi bi-person-vcard text-primary me-2"></i>Thông tin tài khoản</h5>
                    
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted small d-block mb-1">Họ và tên</span>
                                <span class="fw-bold text-dark fs-6">@Model.User.FullName</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted small d-block mb-1">Tên tài khoản (Username)</span>
                                <span class="fw-bold text-dark fs-6">@@@Model.User.Username</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted small d-block mb-1">Vai trò tài khoản</span>
                                <span class="badge @(Model.User.IsAdmin ? "bg-danger" : "bg-primary") px-3 py-1.5 rounded-pill">
                                    @(Model.User.IsAdmin ? "Quản trị viên (Admin)" : "Thành viên (User)")
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted small d-block mb-1">Quan hệ bạn bè</span>
                                <span class="fw-semibold text-dark">
                                    @(Model.FriendshipStatus == "Friends" ? "Đã là bạn bè" : Model.FriendshipStatus == "PendingSent" ? "Đã gửi lời mời" : Model.FriendshipStatus == "PendingReceived" ? "Chờ bạn phản hồi" : "Chưa kết bạn")
                                </span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted small d-block mb-1">Hoạt động trên Connectify</span>
                                <div class="d-flex gap-4 mt-2">
                                    <div><i class="bi bi-pencil-square text-primary me-1"></i><strong>@Model.TotalPosts</strong> bài đăng</div>
                                    <div><i class="bi bi-chat-dots text-success me-1"></i><strong>@Model.TotalComments</strong> bình luận</div>
                                    <div><i class="bi bi-people text-warning me-1"></i><strong>@Model.TotalFriends</strong> bạn bè</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: DANH SÁCH BẠN BÈ -->
            <div class="tab-pane fade" id="other-friends" role="tabpanel" aria-labelledby="other-friends-nav">
                <div class="profile-card p-4 mb-4">
                    <h5 class="form-section-title mb-4">
                        <i class="bi bi-people-fill text-warning me-2"></i>Danh sách bạn bè của @Model.User.FullName (@Model.TotalFriends)
                    </h5>
                    
                    @if (Model.FriendsList != null && Model.FriendsList.Any())
                    {
                        <div class="row g-3">
                            @foreach (var friend in Model.FriendsList)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-center justify-content-between p-3 rounded-4 border bg-light hover-bg-light transition-all">
                                        <a href="/Profile/View/@friend.Username" class="d-flex align-items-center text-decoration-none text-dark flex-grow-1 overflow-hidden me-2">
                                            <img src="@friend.AvatarUrl" alt="@friend.FullName" class="avatar rounded-circle me-3 flex-shrink-0" style="width: 46px; height: 46px; object-fit: cover;" />
                                            <div class="overflow-hidden">
                                                <h6 class="fw-bold mb-0 text-truncate">@friend.FullName</h6>
                                                <span class="text-muted small text-truncate d-block">@@@friend.Username</span>
                                            </div>
                                        </a>
                                        <div class="d-flex gap-1 flex-shrink-0">
                                            <a href="/Profile/View/@friend.Username" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Xem hồ sơ">
                                                Xem hồ sơ
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-people display-3 opacity-50 mb-2 d-block"></i>
                            <h6 class="fw-bold text-dark">Chưa có bạn bè nào</h6>
                            <p class="small text-muted">Người dùng này chưa có bạn bè trong danh sách.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function activateOtherTab(tabId) {
            const tabEl = document.getElementById(tabId);
            if (tabEl) {
                const tab = new bootstrap.Tab(tabEl);
                tab.show();
            }
        }

        $(document).ready(function () {
            // Thêm bạn bè
            $(document).on('click', '.btn-add-friend-action', function () {
                const btn = $(this);
                const userId = btn.data('user-id');
                btn.prop('disabled', true);
                
                $.post('/Friend/SendRequest', { receiverId: userId }, function (res) {
                    if (res.success) {
                        $('#friendActionWrapper').html(`
                            <button class="btn btn-secondary btn-sm rounded-pill px-3 py-1.5 btn-remove-friend-action" data-user-id="${userId}">
                                <i class="bi bi-person-dash me-1"></i>Hủy lời mời
                            </button>
                        `);
                    } else {
                        alert(res.message);
                        btn.prop('disabled', false);
                    }
                });
            });

            // Hủy kết bạn / Hủy lời mời
            $(document).on('click', '.btn-remove-friend-action', function () {
                const btn = $(this);
                const userId = btn.data('user-id');
                if (!confirm('Bạn có chắc chắn muốn thực hiện thao tác này?')) return;
                btn.prop('disabled', true);

                $.post('/Friend/RemoveFriend', { targetUserId: userId }, function (res) {
                    if (res.success) {
                        $('#friendActionWrapper').html(`
                            <button class="btn btn-primary btn-sm rounded-pill px-3 py-1.5 btn-add-friend-action" data-user-id="${userId}">
                                <i class="bi bi-person-plus-fill me-1"></i>Thêm bạn bè
                            </button>
                        `);
                    } else {
                        alert(res.message);
                        btn.prop('disabled', false);
                    }
                });
            });

            // Chấp nhận kết bạn
            $(document).on('click', '.btn-accept-friend-action', function () {
                const btn = $(this);
                const userId = btn.data('user-id');
                btn.prop('disabled', true);

                $.post('/Friend/AcceptRequest', { requestorId: userId }, function (res) {
                    if (res.success) {
                        window.location.reload();
                    } else {
                        alert(res.message);
                        btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
