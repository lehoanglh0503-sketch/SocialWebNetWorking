@using Social_Website.Helpers
@model Social_Website.Models.ProfileViewModel
@{
    ViewData["Title"] = "Trang cá nhân";
    Layout = "_Layout";
    var currentUser = ViewBag.CurrentUser as Social_Website.Models.User ?? Model.User;
}

<style>
    .profile-card {
        border-radius: var(--border-radius);
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        box-shadow: var(--glass-shadow);
        overflow: hidden;
    }
    
    .profile-header-bg {
        height: 130px;
        background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);
    }

    .avatar-wrapper {
        position: relative;
        width: 110px;
        height: 110px;
        margin-top: -55px;
        margin-left: auto;
        margin-right: auto;
        border-radius: 50%;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        cursor: pointer;
    }

    .avatar-wrapper .avatar-img {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #ffffff;
        background-color: var(--primary-light);
        transition: filter 0.3s ease;
    }

    .avatar-wrapper:hover .avatar-img {
        filter: brightness(0.65);
    }

    .avatar-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #ffffff;
        opacity: 0;
        transition: opacity 0.3s ease;
        border-radius: 50%;
    }

    .avatar-wrapper:hover .avatar-overlay {
        opacity: 1;
    }

    .stat-box {
        border-radius: 12px;
        background-color: #f8fafc;
        border: 1px solid var(--border-color);
        transition: all 0.2s ease;
        cursor: pointer;
    }
    
    .stat-box:hover {
        background-color: var(--primary-light);
        color: var(--primary-color) !important;
        transform: translateY(-2px);
    }

    .stat-box i {
        font-size: 1.5rem;
    }

    .form-section-title {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--text-main);
        border-bottom: 2px solid var(--primary-light);
        padding-bottom: 0.5rem;
    }

    .toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 1055;
    }
</style>

<!-- Toast thông báo -->
<div class="toast-container">
    <div id="profileToast" class="toast align-items-center text-white border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi me-2" id="toastIcon"></i><span id="toastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="row py-3 animate-fade-in-up">
    <!-- Cột bên trái: Avatar & Thống kê cá nhân (Sticky) -->
    <div class="col-12 col-lg-4 mb-4">
        <div class="profile-card text-center pb-4 profile-sticky-card">
            <div class="profile-header-bg"></div>
            
            <div class="avatar-wrapper" onclick="triggerAvatarUpload()" title="Nhấp để đổi ảnh đại diện">
                <img src="@Model.User.AvatarUrl" alt="@Model.User.FullName" id="avatarPreview" class="avatar-img" />
                <div class="avatar-overlay">
                    <i class="bi bi-camera-fill fs-4"></i>
                    <span style="font-size: 0.75rem; font-weight: 600;">Thay ảnh</span>
                </div>
            </div>
            
            <h4 class="fw-bold mt-3 mb-1 text-dark" id="profileNameDisplay">@Model.User.FullName</h4>
            <p class="text-muted small mb-3">@@@Model.User.Username</p>
            @if (!string.IsNullOrEmpty(Model.User.Email))
            {
                <div class="badge bg-light text-muted border px-3 py-1.5 rounded-pill mb-3" style="font-weight: 500;">
                    <i class="bi bi-envelope me-1"></i>@Model.User.Email
                </div>
            }
            
            <!-- 3 ô thống kê (Bài đăng, Bình luận, Bạn bè) -->
            <div class="px-4 mb-4">
                <div class="row g-2">
                    <div class="col-4">
                        <div class="stat-box p-3 text-secondary text-decoration-none d-block" onclick="activateTab('tab-posts-nav')">
                            <i class="bi bi-chat-left-text-fill text-success"></i>
                            <div class="fw-bold text-dark mt-1 user-post-count-badge">@Model.TotalPosts</div>
                            <div class="text-muted" style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase;">Bài đăng</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box p-3 text-secondary text-decoration-none d-block">
                            <i class="bi bi-chat-dots-fill text-primary"></i>
                            <div class="fw-bold text-dark mt-1">@Model.TotalComments</div>
                            <div class="text-muted" style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase;">Bình luận</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box p-3 text-secondary text-decoration-none d-block" onclick="activateTab('tab-friends-nav')">
                            <i class="bi bi-people-fill text-warning"></i>
                            <div class="fw-bold text-dark mt-1">@Model.TotalFriends</div>
                            <div class="text-muted" style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase;">Bạn bè</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Action Links -->
            <div class="px-4 d-flex flex-column gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill py-2 fw-semibold d-flex align-items-center justify-content-center" onclick="activateTab('tab-posts-nav'); $('html, body').animate({scrollTop: $('#profilePostComposer').offset().top - 90}, 300); $('#profilePostContent').focus();">
                    <i class="bi bi-pencil-square me-2"></i>Đăng bài viết mới
                </button>
                <button type="button" class="btn btn-light btn-sm rounded-pill py-2 text-muted fw-semibold border d-flex align-items-center justify-content-center" onclick="activateTab('tab-info-nav')">
                    <i class="bi bi-person-gear me-2 text-primary"></i>Cài đặt thông tin tài khoản
                </button>
            </div>
        </div>
    </div>
    
    <!-- Cột bên phải: Tabs (Bài viết của tôi, Thông tin cá nhân, Đổi mật khẩu, Bạn bè) -->
    <div class="col-12 col-lg-8">
        <!-- Navigation Pills -->
        <ul class="nav nav-pills profile-nav-pills bg-white p-2 rounded-4 shadow-sm border mb-4 gap-1 flex-nowrap overflow-auto" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active d-flex align-items-center" id="tab-posts-nav" data-bs-toggle="pill" data-bs-target="#tab-posts" type="button" role="tab" aria-controls="tab-posts" aria-selected="true">
                    <i class="bi bi-grid-3x3 me-2"></i>
                    <span>Bài viết của tôi</span>
                    <span class="badge bg-primary-subtle text-primary ms-2 rounded-pill px-2">@Model.TotalPosts</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link d-flex align-items-center" id="tab-info-nav" data-bs-toggle="pill" data-bs-target="#tab-info" type="button" role="tab" aria-controls="tab-info" aria-selected="false">
                    <i class="bi bi-person-lines-fill me-2"></i>
                    <span>Thông tin</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link d-flex align-items-center" id="tab-password-nav" data-bs-toggle="pill" data-bs-target="#tab-password" type="button" role="tab" aria-controls="tab-password" aria-selected="false">
                    <i class="bi bi-shield-lock-fill me-2"></i>
                    <span>Đổi mật khẩu</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link d-flex align-items-center" id="tab-friends-nav" data-bs-toggle="pill" data-bs-target="#tab-friends" type="button" role="tab" aria-controls="tab-friends" aria-selected="false">
                    <i class="bi bi-people-fill me-2"></i>
                    <span>Bạn bè</span>
                    <span class="badge bg-warning-subtle text-warning-emphasis ms-2 rounded-pill px-2">@Model.TotalFriends</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="profileTabContent">
            <!-- TAB 1: BÀI VIẾT CỦA TÔI -->
            <div class="tab-pane fade show active" id="tab-posts" role="tabpanel" aria-labelledby="tab-posts-nav">
                <!-- Card viết bài mới trên trang cá nhân -->
                <div class="card mb-4 shadow-sm border-0 rounded-4" id="profilePostComposer">
                    <div class="card-body p-4">
                        <div class="d-flex mb-3">
                            <img src="@Model.User.AvatarUrl" alt="@Model.User.FullName" class="avatar avatar-sm me-3" />
                            <div class="w-100">
                                <form id="profileCreatePostForm">
                                    <textarea id="profilePostContent" class="form-control post-input w-100" rows="3" placeholder="Chia sẻ suy nghĩ của bạn trên trang cá nhân..."></textarea>
                                    
                                    <div id="profilePostAlert" class="alert alert-danger d-none mt-2 mb-0 animate-fade-in-up" role="alert" style="border-radius: 12px; font-size: 0.85rem;">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        <span id="profilePostAlertMsg"></span>
                                    </div>
                                    
                                    <div id="profileImagePreviewArea" class="mt-3 row g-2 d-none"></div>

                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        <div class="d-flex gap-2">
                                            <input type="file" id="profilePostImages" multiple accept="image/*" class="d-none" />
                                            <label for="profilePostImages" class="btn btn-light btn-sm text-primary fw-semibold rounded-pill px-3 cursor-pointer mb-0">
                                                <i class="bi bi-images me-1 fs-6"></i>Thêm ảnh
                                            </label>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4" id="btnSubmitProfilePost">
                                            <i class="bi bi-send-fill me-1"></i>Đăng bài
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Danh sách bài viết -->
                <div id="profileFeedContainer">
                    @if (Model.Posts != null && Model.Posts.Any())
                    {
                        foreach (var post in Model.Posts)
                        {
                            <partial name="_PostCard" model="post" />
                        }
                    }
                    else
                    {
                        <div class="card border-0 shadow-sm text-center py-5 rounded-4 mb-4">
                            <div class="card-body">
                                <i class="bi bi-file-earmark-post display-2 text-muted opacity-50 mb-3 d-block"></i>
                                <h5 class="fw-bold text-dark">Chưa có bài viết nào</h5>
                                <p class="text-muted small mb-3">Bạn chưa đăng bài viết nào trên trang cá nhân. Hãy tạo bài viết đầu tiên ngay!</p>
                                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="$('#profilePostContent').focus();">
                                    <i class="bi bi-plus-circle me-1"></i>Đăng bài ngay
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- TAB 2: THÔNG TIN CÁ NHÂN -->
            <div class="tab-pane fade" id="tab-info" role="tabpanel" aria-labelledby="tab-info-nav">
                <div class="profile-card p-4 mb-4">
                    <h5 class="form-section-title mb-4"><i class="bi bi-person-fill text-primary me-2"></i>Thông tin cá nhân</h5>
                    
                    <form id="profileForm" enctype="multipart/form-data">
                        <input type="file" id="avatarUploadInput" name="avatarFile" style="display: none;" accept="image/*" onchange="previewImage(event)" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Tên tài khoản (Không thể thay đổi)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">@@</span>
                                <input type="text" class="form-control bg-light text-muted" value="@Model.User.Username" readonly />
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="fullNameInput" class="form-label fw-semibold text-muted small">Họ tên đầy đủ</label>
                            <input type="text" id="fullNameInput" name="fullName" class="form-control form-control-modern" value="@Model.User.FullName" required minlength="2" maxlength="100" />
                        </div>
                        
                        <div class="mb-4">
                            <label for="emailInput" class="form-label fw-semibold text-muted small">Địa chỉ Email (Dùng để đặt lại mật khẩu)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" id="emailInput" name="email" class="form-control form-control-modern border-start-0" value="@Model.User.Email" placeholder="Bổ sung địa chỉ email..." />
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary px-4 rounded-pill" id="saveProfileBtn">
                            <span class="spinner-border spinner-border-sm me-2 d-none" role="status" id="profileSpinner"></span>
                            <i class="bi bi-check-circle me-1" id="profileIcon"></i>Lưu thay đổi
                        </button>
                    </form>
                </div>
            </div>

            <!-- TAB 3: BẢO MẬT & MẬT KHẨU -->
            <div class="tab-pane fade" id="tab-password" role="tabpanel" aria-labelledby="tab-password-nav">
                <div class="profile-card p-4 mb-4">
                    <h5 class="form-section-title mb-4"><i class="bi bi-shield-lock-fill text-danger me-2"></i>Bảo mật & Mật khẩu</h5>
                    
                    <form id="passwordForm">
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label fw-semibold text-muted small">Mật khẩu hiện tại</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                <input type="password" id="currentPassword" name="currentPassword" class="form-control form-control-modern border-start-0 border-end-0" placeholder="••••••••" required />
                                <span class="input-group-text bg-white border-start-0 text-muted toggle-password-btn" data-target="#currentPassword" title="Hiện mật khẩu">
                                    <i class="bi bi-eye-fill"></i>
                                </span>
                            </div>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label for="newPassword" class="form-label fw-semibold text-muted small">Mật khẩu mới (Tối thiểu 6 ký tự)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-key text-muted"></i></span>
                                    <input type="password" id="newPassword" name="newPassword" class="form-control form-control-modern border-start-0 border-end-0" placeholder="••••••••" required minlength="6" />
                                    <span class="input-group-text bg-white border-start-0 text-muted toggle-password-btn" data-target="#newPassword" title="Hiện mật khẩu">
                                        <i class="bi bi-eye-fill"></i>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="confirmPassword" class="form-label fw-semibold text-muted small">Xác nhận mật khẩu mới</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control form-control-modern border-start-0 border-end-0" placeholder="••••••••" required />
                                    <span class="input-group-text bg-white border-start-0 text-muted toggle-password-btn" data-target="#confirmPassword" title="Hiện mật khẩu">
                                        <i class="bi bi-eye-fill"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-outline-danger px-4 rounded-pill" id="changePasswordBtn">
                            <span class="spinner-border spinner-border-sm me-2 d-none" role="status" id="passwordSpinner"></span>
                            <i class="bi bi-key me-1" id="passwordIcon"></i>Cập nhật mật khẩu
                        </button>
                    </form>
                </div>
            </div>

            <!-- TAB 4: BẠN BÈ -->
            <div class="tab-pane fade" id="tab-friends" role="tabpanel" aria-labelledby="tab-friends-nav">
                <div class="profile-card p-4 mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h5 class="form-section-title mb-0 border-bottom-0 pb-0">
                            <i class="bi bi-people-fill text-warning me-2"></i>Danh sách bạn bè (@Model.TotalFriends)
                        </h5>
                        <a href="/Friend" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            <i class="bi bi-person-plus me-1"></i>Quản lý bạn bè
                        </a>
                    </div>
                    
                    @if (Model.FriendsList != null && Model.FriendsList.Any())
                    {
                        <div class="row g-3">
                            @foreach (var friend in Model.FriendsList)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-center justify-content-between p-3 rounded-4 border bg-light hover-bg-light transition-all">
                                        <a href="/Profile/View/@friend.Username" class="d-flex align-items-center text-decoration-none text-dark flex-grow-1 overflow-hidden me-2">
                                            <img src="@friend.AvatarUrl" alt="@friend.FullName" class="avatar rounded-circle me-3 flex-shrink-0" style="width: 46px; height: 46px; object-fit: cover;" />
                                            <div class="overflow-hidden">
                                                <h6 class="fw-bold mb-0 text-truncate">@friend.FullName</h6>
                                                <span class="text-muted small text-truncate d-block">@@@friend.Username</span>
                                            </div>
                                        </a>
                                        <div class="d-flex gap-1 flex-shrink-0">
                                            <a href="/Profile/View/@friend.Username" class="btn btn-outline-primary btn-sm rounded-pill px-2.5" title="Xem hồ sơ">
                                                <i class="bi bi-person"></i>
                                            </a>
                                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-2.5 btn-open-chat" data-friend-id="@friend.UserId" data-friend-name="@friend.FullName" data-friend-avatar="@friend.AvatarUrl" title="Nhắn tin">
                                                <i class="bi bi-chat-dots-fill"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-people display-3 opacity-50 mb-2 d-block"></i>
                            <h6 class="fw-bold text-dark">Bạn chưa có bạn bè nào</h6>
                            <p class="small text-muted mb-3">Hãy tìm kiếm và kết bạn với mọi người để cùng chia sẻ nhé!</p>
                            <a href="/Friend" class="btn btn-primary btn-sm rounded-pill px-4">Tìm bạn bè</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function activateTab(tabId) {
            const tabEl = document.getElementById(tabId);
            if (tabEl) {
                const tab = new bootstrap.Tab(tabEl);
                tab.show();
            }
        }

        function triggerAvatarUpload() {
            document.getElementById('avatarUploadInput').click();
        }

        function previewImage(event) {
            const input = event.target;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function showProfileToast(message, isSuccess = true) {
            const toastEl = document.getElementById('profileToast');
            const toastMsg = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');
            
            toastEl.className = 'toast align-items-center text-white border-0 shadow ' + (isSuccess ? 'bg-success' : 'bg-danger');
            toastIcon.className = 'bi me-2 ' + (isSuccess ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill');
            toastMsg.innerText = message;
            
            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
        }

        $(document).ready(function () {
            // 1. Submit Form cập nhật thông tin cá nhân
            $('#profileForm').on('submit', function (e) {
                e.preventDefault();
                const btn = $('#saveProfileBtn');
                const spinner = $('#profileSpinner');
                const icon = $('#profileIcon');
                
                btn.prop('disabled', true);
                spinner.removeClass('d-none');
                icon.addClass('d-none');
                
                const formData = new FormData(this);
                
                $.ajax({
                    url: '/Profile/UpdateProfile',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        btn.prop('disabled', false);
                        spinner.addClass('d-none');
                        icon.removeClass('d-none');
                        
                        if (res.success) {
                            showProfileToast(res.message, true);
                            $('#profileNameDisplay').text($('#fullNameInput').val());
                            if (res.newAvatarUrl) {
                                $('#avatarPreview').src = res.newAvatarUrl;
                            }
                        } else {
                            showProfileToast(res.message, false);
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false);
                        spinner.addClass('d-none');
                        icon.removeClass('d-none');
                        showProfileToast("Đã có lỗi hệ thống xảy ra. Vui lòng thử lại!", false);
                    }
                });
            });

            // 2. Submit Form đổi mật khẩu
            $('#passwordForm').on('submit', function (e) {
                e.preventDefault();
                const btn = $('#changePasswordBtn');
                const spinner = $('#passwordSpinner');
                const icon = $('#passwordIcon');
                
                const currPass = $('#currentPassword').val();
                const newPass = $('#newPassword').val();
                const confirmPass = $('#confirmPassword').val();
                
                if (newPass !== confirmPass) {
                    showProfileToast("Mật khẩu mới và xác nhận mật khẩu không khớp!", false);
                    return;
                }
                
                btn.prop('disabled', true);
                spinner.removeClass('d-none');
                icon.addClass('d-none');
                
                $.post('/Profile/ChangePassword', {
                    currentPassword: currPass,
                    newPassword: newPass,
                    confirmPassword: confirmPass
                }, function (res) {
                    btn.prop('disabled', false);
                    spinner.addClass('d-none');
                    icon.removeClass('d-none');
                    
                    if (res.success) {
                        showProfileToast(res.message, true);
                        $('#passwordForm')[0].reset();
                    } else {
                        showProfileToast(res.message, false);
                    }
                }).fail(function () {
                    btn.prop('disabled', false);
                    spinner.addClass('d-none');
                    icon.removeClass('d-none');
                    showProfileToast("Đã có lỗi hệ thống xảy ra. Vui lòng thử lại!", false);
                });
            });

            // 3. Post composer trên trang cá nhân
            let profileFiles = [];
            $('#profilePostImages').on('change', function () {
                const files = Array.from(this.files);
                profileFiles = profileFiles.concat(files);
                renderProfilePreviews();
            });

            function renderProfilePreviews() {
                const area = $('#profileImagePreviewArea');
                area.empty();
                if (profileFiles.length === 0) {
                    area.addClass('d-none');
                    return;
                }
                area.removeClass('d-none');
                profileFiles.forEach((f, idx) => {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        area.append(`
                            <div class="col-3 position-relative">
                                <img src="${e.target.result}" class="img-fluid rounded shadow-sm w-100" style="height: 90px; object-fit: cover;" />
                                <button type="button" class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 p-0 shadow" style="width: 22px; height: 22px; line-height: 1; transform: translate(20%, -20%);" onclick="removeProfileImg(${idx})">&times;</button>
                            </div>
                        `);
                    };
                    reader.readAsDataURL(f);
                });
            }

            window.removeProfileImg = function(idx) {
                profileFiles.splice(idx, 1);
                renderProfilePreviews();
            };

            $('#profileCreatePostForm').on('submit', function (e) {
                e.preventDefault();
                const content = $('#profilePostContent').val();
                if ((!content || content.trim().length === 0) && profileFiles.length === 0) {
                    return;
                }

                const btn = $('#btnSubmitProfilePost');
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang đăng...');

                const formData = new FormData();
                formData.append('content', content);
                profileFiles.forEach(f => formData.append('images', f));

                $.ajax({
                    url: '/Post/CreatePost',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="bi bi-send-fill me-1"></i>Đăng bài');
                        if (res.success) {
                            $('#profilePostContent').val('');
                            profileFiles = [];
                            $('#profileImagePreviewArea').empty().addClass('d-none');
                            $('#profilePostAlert').addClass('d-none');
                            showProfileToast("Đăng bài viết thành công!", true);
                            setTimeout(() => window.location.reload(), 600);
                        } else {
                            if (res.detectedWords && res.detectedWords.length > 0) {
                                $('#profilePostAlertMsg').text("Bài viết chứa từ ngữ vi phạm: " + res.detectedWords.join(', '));
                                $('#profilePostAlert').removeClass('d-none');
                            } else {
                                showProfileToast(res.message, false);
                            }
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="bi bi-send-fill me-1"></i>Đăng bài');
                        showProfileToast("Lỗi khi kết nối tới máy chủ!", false);
                    }
                });
            });
        });
    </script>
}
