@{
    ViewData["Title"] = "Giới thiệu thành viên";
    Layout = "_Layout";
}

<div class="container py-4" style="max-width: 900px;">
    <h3 class="fw-bold text-center mb-4 text-uppercase">BẢNG PHÂN CÔNG NHIỆM VỤ</h3>

    <!-- Bảng phân công đơn giản gồm Ảnh + Tên + Nhiệm vụ -->
    <div class="table-responsive shadow-sm rounded border">
        <table class="table table-bordered align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 25%;">Tên thành viên</th>
                    <th style="width: 65%;">Nhiệm Vụ</th>
                    <th style="width: 10%;">Mức Độ Hoàn Thành</th>
                </tr>
            </thead>
            <tbody>
                <!-- Lê Hoàng -->
                <tr>
                    <td class="py-3 bg-light">
                        <img src="/images/le_hoang.jpg" alt="Lê Hoàng" class="rounded shadow-sm mb-2" style="width: 100px; height: 120px; object-fit: cover;" />
                        <div class="fw-bold fs-6">Lê Hoàng</div>
                    </td>
                    <td class="text-start p-3">
                        <div class="mb-2">• <strong>Web:</strong> Thiết kế UI/UX giao diện Mạng Xã Hội Connectify (Newsfeed, Profile, Auth); Lập trình Module Bài viết, Đăng bài kèm ảnh (/uploads/posts/), Thả cảm xúc 6 loại (Like/Love/Haha...) &amp; Bình luận lồng nhau.</div>
                        <div>• <strong>Báo cáo:</strong> Biên soạn báo cáo tổng hợp, thiết kế Sơ đồ luồng dữ liệu DFD Mức 0, 1, 2, Sơ đồ Use Case (1-include 1-extend), 16 Đặc tả Use Case &amp; Deployment Diagram.</div>
                    </td>
                    <td class="fw-bold text-success fs-6">100%</td>
                </tr>

                <!-- Phạm Tấn Tài -->
                <tr>
                    <td class="py-3 bg-light">
                        <img src="/images/pham_tan_tai.jpg" alt="Phạm Tấn Tài" class="rounded shadow-sm mb-2" style="width: 100px; height: 120px; object-fit: cover;" />
                        <div class="fw-bold fs-6">Phạm Tấn Tài</div>
                    </td>
                    <td class="text-start p-3">
                        <div class="mb-2">• <strong>Web:</strong> Lập trình Module Kết nối bạn bè (Friendships), Gợi ý kết bạn &amp; Nhắn tin trò chuyện 1-1 real-time qua SignalR ChatHub; Lập trình Trang Admin Dashboard (Thống kê 4 chỉ số, Reset pass, Xóa user Cascade Clean, Duyệt PostReports &amp; BannedWords).</div>
                        <div>• <strong>Báo cáo:</strong> Vẽ Sơ đồ Trạng thái (State Diagram), Sơ đồ Hoạt động Swimlane (Activity Diagram), Sơ đồ Thực thể ERD 9 bảng &amp; Sơ đồ Logic CSDL.</div>
                    </td>
                    <td class="fw-bold text-success fs-6">100%</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
