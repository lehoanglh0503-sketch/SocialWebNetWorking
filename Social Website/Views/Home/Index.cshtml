@using Social_Website.Helpers
@model IEnumerable<Social_Website.Models.Post>
@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_Layout";
    var currentUser = ViewBag.CurrentUser as Social_Website.Models.User;
}

<style>
    .cursor-pointer {
        cursor: pointer;
    }
    .hover-underline:hover {
        text-decoration: underline !important;
    }
</style>

<div class="row">
    <!-- Cột trái: Thông tin cá nhân thu gọn (Sticky) -->
    <div class="col-12 col-md-4 col-lg-3 mb-4 order-2 order-lg-1">
        <div class="card sidebar-sticky">
            <div class="card-body text-center py-4">
                <a href="/Profile" class="text-decoration-none">
                    <img src="@currentUser?.AvatarUrl" alt="@currentUser?.FullName" class="avatar avatar-lg shadow-sm mb-3 border border-2 border-primary" />
                    <h5 class="fw-bold mb-1 text-dark hover-primary">@currentUser?.FullName</h5>
                </a>
                <p class="text-muted small mb-3">@@@currentUser?.Username</p>
                <hr class="my-3" />
                <div class="d-flex justify-content-around text-center">
                    <div>
                        <span class="d-block fw-bold fs-5 text-primary user-post-count-badge">@(currentUser?.Posts?.Count ?? 0)</span>
                        <span class="text-muted small">Bài viết</span>
                    </div>
                </div>
                <div class="mt-3">
                    <a href="/Profile" class="btn btn-outline-primary btn-sm rounded-pill w-100 fw-semibold">
                        <i class="bi bi-person-fill me-1"></i>Trang cá nhân
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột giữa: Feed bài đăng -->
    <div class="@(currentUser != null && currentUser.IsAdmin ? "col-12 col-md-8 col-lg-9 order-1 order-lg-2" : "col-12 col-md-12 col-lg-6 order-1 order-lg-2") mb-4">
        <!-- Card viết bài mới -->
        <div class="card mb-4 shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <div class="d-flex mb-3">
                    <a href="/Profile">
                        <img src="@currentUser?.AvatarUrl" alt="@currentUser?.FullName" class="avatar avatar-sm me-3" />
                    </a>
                    <div class="w-100">
                        <form id="createPostForm">
                            <textarea id="postContent" class="form-control post-input w-100" rows="3" placeholder="Hôm nay bạn thế nào, @(currentUser?.FullName)?..."></textarea>
                            
                            <!-- Cảnh báo từ ngữ bạo lực -->
                            <div id="postValidationAlert" class="alert alert-danger d-none mt-2 mb-0 animate-fade-in-up" role="alert" style="border-radius: 12px; font-size: 0.85rem;">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <span id="postValidationMessage"></span>
                            </div>

                            <!-- Xem trước ảnh được chọn (Hỗ trợ tối đa 5 ảnh) -->
                            <div id="postImagePreviewWrapper" class="d-none mt-2 mb-2">
                                <div class="row g-2" id="postImagePreviewContainer"></div>
                            </div>

                            <!-- Xem trước video được chọn (Tối đa 25MB) -->
                            <div id="postVideoPreviewWrapper" class="d-none mt-2 mb-2 position-relative">
                                <video id="postVideoPreview" controls class="w-100 rounded shadow-sm" style="max-height: 250px;"></video>
                                <button type="button" class="btn btn-sm btn-dark position-absolute top-0 end-0 m-2 rounded-circle" id="btnRemoveVideoPreview" style="width: 24px; height: 24px; padding: 0; line-height: 1;" title="Xóa video">
                                    <i class="bi bi-x-lg" style="font-size: 0.75rem;"></i>
                                </button>
                            </div>

                            <input type="file" id="postImageInput" accept="image/jpeg,image/png,image/webp,image/gif" multiple class="d-none" />
                            <input type="file" id="postVideoInput" accept="video/mp4,video/webm" class="d-none" />

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <div class="d-flex text-muted gap-3 small">
                                    <span class="cursor-pointer hover-primary" onclick="$('#postImageInput').click();"><i class="bi bi-image text-success me-1"></i>Ảnh</span>
                                    <span class="cursor-pointer hover-primary" onclick="$('#postVideoInput').click();"><i class="bi bi-camera-reels text-danger me-1"></i>Video</span>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4" id="btnSubmitPost">Đăng bài</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Danh sách bài đăng (Feed) -->
        <div id="feedContainer">
            @if (Model != null && Model.Any())
            {
                foreach (var post in Model)
                {
                    <partial name="_PostCard" model="post" />
                }
            }
            else
            {
                <div class="card border-0 shadow-sm text-center py-5 rounded-4 mb-4">
                    <div class="card-body">
                        <i class="bi bi-chat-square-dots display-3 text-muted opacity-50 mb-3 d-block"></i>
                        <h5 class="fw-bold text-dark">Chưa có bài viết nào</h5>
                        <p class="text-muted small mb-0">Hãy chia sẻ suy nghĩ đầu tiên của bạn hoặc kết nối thêm bạn bè!</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Cột phải: Gợi ý kết bạn & Trò chuyện -->
    @if (currentUser != null && !currentUser.IsAdmin)
    {
        <div class="col-12 col-md-12 col-lg-3 mb-4 order-3 order-lg-3" id="sidebarRightContainer">
            <div class="sidebar-sticky">
                <div class="row g-4 mx-0">
                    <div class="col-12 col-md-6 col-lg-12">
                        @await Component.InvokeAsync("RecommendedUsers")
                    </div>
                    <div class="col-12 col-md-6 col-lg-12">
                        <!-- Hộp danh sách bạn bè để chat -->
                        <div class="card border-0 shadow-sm" id="friendsListCard">
                            <div class="card-header bg-white border-0 pt-3.5 px-3.5 pb-2">
                                <h6 class="fw-bold mb-0 text-primary d-flex align-items-center">
                                    <i class="bi bi-chat-dots-fill me-2"></i>Danh sách bạn bè
                                </h6>
                            </div>
                            <div class="card-body px-3.5 pb-3.5 pt-2">
                                <div class="d-flex flex-column gap-2.5" id="chatFriendsList">
                                    @if (ViewBag.Friends != null && ((IEnumerable<Social_Website.Models.User>)ViewBag.Friends).Any())
                                    {
                                        foreach (var friend in (IEnumerable<Social_Website.Models.User>)ViewBag.Friends)
                                        {
                                            <div class="d-flex align-items-center justify-content-between gap-2 py-1 cursor-pointer btn-open-chat border-bottom border-light last-border-0" data-friend-id="@friend.UserId" data-friend-name="@friend.FullName" data-friend-avatar="@friend.AvatarUrl">
                                                <div class="d-flex align-items-center me-1 overflow-hidden flex-grow-1" style="min-width: 0;">
                                                    <img src="@friend.AvatarUrl" alt="@friend.FullName" class="avatar avatar-sm me-2 flex-shrink-0" />
                                                    <div class="overflow-hidden flex-grow-1" style="min-width: 0;">
                                                        <h6 class="fw-semibold mb-0 small text-truncate" title="@friend.FullName" style="white-space: nowrap !important; word-break: normal !important;">@friend.FullName</h6>
                                                        <span class="text-muted small text-truncate d-block" style="font-size: 0.72rem; white-space: nowrap !important;">@@@friend.Username</span>
                                                    </div>
                                                </div>
                                                <button class="btn btn-light btn-sm rounded-circle p-1 border-0 flex-shrink-0 d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                                                    <i class="bi bi-chat-fill text-primary" style="font-size: 0.85rem;"></i>
                                                </button>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-0">Chưa có bạn bè nào. Hãy kết bạn để nhắn tin!</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nút Chat Nhanh dạng Nút Nổi trên Màn hình Điện thoại (Floating Mobile Chat Button) -->
        <button type="button" class="btn btn-primary rounded-circle shadow-lg d-lg-none position-fixed btn-mobile-quick-chat" id="btnMobileQuickChat" title="Mở danh sách trò chuyện" style="bottom: 24px; right: 24px; width: 54px; height: 54px; z-index: 1040; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-chat-dots-fill fs-4"></i>
        </button>
    }
</div>
