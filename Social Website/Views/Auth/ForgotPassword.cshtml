@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center mt-5">
    <div class="col-md-5">
        <div class="card p-4 shadow-lg border-0 animate-fade-in-up">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle p-3 mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-key-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold">Quên mật khẩu</h3>
                    <p class="text-muted">Nhập email đăng ký của bạn để nhận hướng dẫn đặt lại mật khẩu</p>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Message as string))
                {
                    <div class="alert alert-info border-0 rounded-3 mb-4 text-center" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>@ViewBag.Message
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 rounded-3 mb-4" role="alert">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                    </div>
                }

                <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                    <div class="mb-4">
                        <label for="email" class="form-label fw-semibold">Địa chỉ Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input type="email" class="form-control form-control-modern border-start-0" id="email" name="email" placeholder="name@example.com" required autocomplete="off" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2.5 mb-3">Gửi yêu cầu đặt lại mật khẩu</button>
                    
                    <div class="text-center mt-3">
                        <a asp-controller="Auth" asp-action="Login" class="text-decoration-none fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại Đăng nhập
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
