@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center mt-4">
    <div class="col-md-5">
        <div class="card p-4 shadow-lg border-0 animate-fade-in-up">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle p-3 mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold">Đăng ký thành viên</h3>
                    <p class="text-muted">Tham gia Connectify cùng hàng ngàn lập trình viên</p>
                </div>

                <form asp-controller="Auth" asp-action="Register" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 rounded-3 mb-4" role="alert">
                            <div asp-validation-summary="All" class="text-danger small"></div>
                        </div>
                    }

                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold">Tên tài khoản</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                            <input type="text" class="form-control form-control-modern border-start-0" id="username" name="username" placeholder="Nhập tên tài khoản..." required autocomplete="off" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="fullName" class="form-label fw-semibold">Tên đầy đủ</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-card-text text-muted"></i></span>
                            <input type="text" class="form-control form-control-modern border-start-0" id="fullName" name="fullName" placeholder="Nhập tên đầy đủ..." required autocomplete="off" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input type="password" class="form-control form-control-modern border-start-0" id="password" name="password" placeholder="Nhập mật khẩu..." required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock-check text-muted"></i></span>
                            <input type="password" class="form-control form-control-modern border-start-0" id="confirmPassword" name="confirmPassword" placeholder="Nhập lại mật khẩu..." required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2.5 mb-3">Đăng ký tài khoản</button>
                    
                    <div class="text-center mt-3">
                        <span class="text-muted">Đã có tài khoản?</span>
                        <a asp-controller="Auth" asp-action="Login" class="text-decoration-none fw-semibold">Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
