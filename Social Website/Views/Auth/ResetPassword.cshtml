@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_Layout";
    var token = ViewBag.Token as string ?? Context.Request.Query["token"].ToString();
    var email = ViewBag.Email as string ?? Context.Request.Query["email"].ToString();
}

<div class="row justify-content-center align-items-center mt-5">
    <div class="col-md-5">
        <div class="card p-4 shadow-lg border-0 animate-fade-in-up">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle p-3 mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                    <h3 class="fw-bold">Đặt lại mật khẩu</h3>
                    <p class="text-muted">Tạo mật khẩu mới cho tài khoản: <strong>@email</strong></p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 rounded-3 mb-4" role="alert">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                    </div>
                }

                <form asp-controller="Auth" asp-action="ResetPassword" method="post">
                    <input type="hidden" name="token" value="@token" />
                    <input type="hidden" name="email" value="@email" />

                    <div class="mb-3">
                        <label for="newPassword" class="form-label fw-semibold">Mật khẩu mới (Tối thiểu 6 ký tự)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input type="password" class="form-control form-control-modern border-start-0 border-end-0" id="newPassword" name="newPassword" placeholder="••••••••" required minlength="6" />
                            <span class="input-group-text bg-white border-start-0 text-muted toggle-password-btn" data-target="#newPassword" title="Hiện mật khẩu">
                                <i class="bi bi-eye-fill"></i>
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-shield-lock text-muted"></i></span>
                            <input type="password" class="form-control form-control-modern border-start-0 border-end-0" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required />
                            <span class="input-group-text bg-white border-start-0 text-muted toggle-password-btn" data-target="#confirmPassword" title="Hiện mật khẩu">
                                <i class="bi bi-eye-fill"></i>
                            </span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2.5 mb-3">Lưu mật khẩu mới</button>
                    
                    <div class="text-center mt-3">
                        <a asp-controller="Auth" asp-action="Login" class="text-decoration-none fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại Đăng nhập
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
