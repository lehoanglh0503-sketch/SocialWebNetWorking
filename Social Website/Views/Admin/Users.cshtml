@model IEnumerable<Social_Website.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "_Layout";
    long currentUserId = ViewBag.CurrentUserId;
}

<style>
    .table th {
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        border-bottom: 1px solid var(--border-color);
        background-color: #f8fafc !important;
        padding-top: 12px;
        padding-bottom: 12px;
    }
    .table tbody tr {
        transition: background-color 0.2s ease;
    }
    .table tbody tr:hover {
        background-color: #f8fafc;
    }
    .avatar {
        transition: transform 0.2s ease;
    }
    .avatar:hover {
        transform: scale(1.1);
    }
</style>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm p-4 animate-fade-in-up">
            <h2 class="fw-bold mb-4 text-primary"><i class="bi bi-speedometer2 me-2"></i>Hệ thống Quản trị Connectify</h2>
            
            <div class="d-flex gap-3">
                <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-primary"><i class="bi bi-flag-fill me-1"></i>Xem báo cáo</a>
                <a href="@Url.Action("Users", "Admin")" class="btn btn-primary"><i class="bi bi-people-fill me-1"></i>Quản lý người dùng</a>
            </div>
        </div>
    </div>
</div>

<!-- Quản lý người dùng -->
<div class="card border-0 shadow-sm p-4 animate-fade-in-up">
    <h4 class="fw-bold mb-4 text-secondary"><i class="bi bi-people-fill text-primary me-2"></i>Danh sách thành viên</h4>
    
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 22%">Thành viên</th>
                        <th style="width: 18%">Tài khoản</th>
                        <th style="width: 15%">Vai trò</th>
                        <th style="width: 15%">Trạng thái</th>
                        <th style="width: 30%; min-width: 310px;" class="text-end text-nowrap">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr id="userRow-@user.UserId">
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@user.AvatarUrl" alt="@user.FullName" class="avatar avatar-sm me-3" />
                                    <span class="fw-bold text-dark text-nowrap">@user.FullName</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted text-nowrap">@@@user.Username</span>
                            </td>
                            <td>
                                @if (user.IsAdmin)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small rounded text-nowrap" style="font-weight: 500;">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 small rounded text-nowrap" style="font-weight: 500;">Thành viên</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLocked)
                                {
                                    <span class="badge bg-danger text-white px-2 py-1 small rounded text-nowrap"><i class="bi bi-lock-fill me-1"></i>Đã bị khóa</span>
                                }
                                else if (user.ApprovedReportCount > 0)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1 small rounded text-nowrap"><i class="bi bi-exclamation-triangle-fill me-1"></i>Vi phạm: @user.ApprovedReportCount/3</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small rounded text-nowrap"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                                }
                            </td>
                            <td class="text-end text-nowrap" style="white-space: nowrap;">
                                <div class="d-flex justify-content-end gap-1.5 align-items-center flex-nowrap">
                                     @if (user.UserId != currentUserId)
                                     {
                                         <button class="btn btn-sm @(user.IsLocked ? "btn-outline-success" : "btn-outline-warning") px-2.5 py-1 rounded-pill text-nowrap btn-toggle-lock-user" data-user-id="@user.UserId" data-is-locked="@user.IsLocked.ToString().ToLower()" style="white-space: nowrap; font-size: 0.82rem;">
                                             <i class="bi @(user.IsLocked ? "bi-unlock-fill" : "bi-lock-fill") me-1"></i>@(user.IsLocked ? "Mở khóa" : "Khóa")
                                         </button>
                                         <button class="btn btn-sm btn-outline-primary px-2.5 py-1 rounded-pill text-nowrap btn-change-password-trigger" data-user-id="@user.UserId" data-user-fullname="@user.FullName" data-user-username="@user.Username" style="white-space: nowrap; font-size: 0.82rem;">
                                             <i class="bi bi-key-fill me-1"></i>Đổi mật khẩu
                                         </button>
                                         <button class="btn btn-sm btn-outline-danger px-2.5 py-1 rounded-pill text-nowrap btn-delete-user" data-user-id="@user.UserId" style="white-space: nowrap; font-size: 0.82rem;">
                                             <i class="bi bi-trash-fill me-1"></i>Xóa
                                         </button>
                                     }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-3 py-1.5 rounded-pill small italic text-nowrap">Tài khoản của bạn</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-0">Không tìm thấy người dùng nào.</p>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Mở modal đổi mật khẩu
            $(document).on("click", ".btn-change-password-trigger", function (e) {
                e.preventDefault();
                const userId = $(this).data("user-id");
                const fullname = $(this).data("user-fullname");
                const username = $(this).data("user-username");
                
                $("#changePasswordUserId").val(userId);
                $("#changePasswordTargetName").html(`${fullname} (<span class="text-primary">@@${username}</span>)`);
                $("#changePasswordNewInput").val("");
                $("#changePasswordConfirmInput").val("");
                $("#changePasswordModal").modal("show");
            });

            // Gửi yêu cầu đổi mật khẩu qua AJAX
            $("#changePasswordForm").submit(function (e) {
                e.preventDefault();
                const userId = $("#changePasswordUserId").val();
                const newPassword = $("#changePasswordNewInput").val();
                const confirmPassword = $("#changePasswordConfirmInput").val();
                
                if (newPassword !== confirmPassword) {
                    alert("Xác nhận mật khẩu mới không trùng khớp!");
                    return;
                }
                
                $.post("/Admin/ChangeUserPassword", { id: userId, newPassword: newPassword }, function (res) {
                    if (res.success) {
                        $("#changePasswordModal").modal("hide");
                        alert(res.message);
                    } else {
                        alert(res.message);
                    }
                });
            });

            // Khóa / Mở khóa tài khoản thủ công
            $(document).on("click", ".btn-toggle-lock-user", function (e) {
                e.preventDefault();
                const userId = $(this).data("user-id");
                const isLocked = $(this).data("is-locked") === true || $(this).data("is-locked") === "true";
                const actionText = isLocked ? "MỞ KHÓA" : "KHÓA";

                if (confirm(`Bạn có chắc chắn muốn ${actionText} tài khoản này không?`)) {
                    $.post("/Admin/ToggleLockUser", { id: userId }, function (res) {
                        if (res.success) {
                            alert(res.message);
                            location.reload();
                        } else {
                            alert(res.message);
                        }
                    });
                }
            });

            // Xóa người dùng
            $(document).on("click", ".btn-delete-user", function () {
                if (confirm("CẢNH BÁO: Bạn có chắc chắn muốn xóa tài khoản này không? Hành động này sẽ xóa vĩnh viễn người dùng cùng toàn bộ bài viết, bình luận, lượt thích và bạn bè của họ. Không thể khôi phục!")) {
                    const userId = $(this).data("user-id");
                    const $row = $(`#userRow-${userId}`);
                    
                    $.post("/Admin/DeleteUser", { id: userId }, function (res) {
                        if (res.success) {
                            alert(res.message);
                            $row.fadeOut(300, function() { $(this).remove(); });
                        } else {
                            alert(res.message);
                        }
                    });
                }
            });
        });
    </script>
}

<!-- Modal Đổi mật khẩu cho người dùng -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 20px;">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-primary" id="changePasswordModalLabel"><i class="bi bi-key-fill me-2"></i>Đổi mật khẩu người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="changePasswordForm">
                <div class="modal-body py-4">
                    <input type="hidden" id="changePasswordUserId" />
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Người dùng</label>
                        <div class="fw-bold fs-6 text-dark" id="changePasswordTargetName"></div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="changePasswordNewInput" class="form-label text-muted small fw-semibold">Mật khẩu mới (Tối thiểu 6 ký tự)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0" style="border-top-left-radius: 12px; border-bottom-left-radius: 12px;"><i class="bi bi-lock text-muted"></i></span>
                            <input type="password" id="changePasswordNewInput" class="form-control form-control-modern border-start-0 border-end-0 px-3 py-2.5" placeholder="Nhập mật khẩu mới..." required minlength="6" />
                            <span class="input-group-text bg-white border-start-0 text-muted toggle-password-btn" data-target="#changePasswordNewInput" title="Hiện mật khẩu" style="border-top-right-radius: 12px; border-bottom-right-radius: 12px;">
                                <i class="bi bi-eye-fill"></i>
                            </span>
                        </div>
                    </div>
                    
                    <div class="mb-0">
                        <label for="changePasswordConfirmInput" class="form-label text-muted small fw-semibold">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0" style="border-top-left-radius: 12px; border-bottom-left-radius: 12px;"><i class="bi bi-lock-check text-muted"></i></span>
                            <input type="password" id="changePasswordConfirmInput" class="form-control form-control-modern border-start-0 border-end-0 px-3 py-2.5" placeholder="Nhập lại mật khẩu mới..." required minlength="6" />
                            <span class="input-group-text bg-white border-start-0 text-muted toggle-password-btn" data-target="#changePasswordConfirmInput" title="Hiện mật khẩu" style="border-top-right-radius: 12px; border-bottom-right-radius: 12px;">
                                <i class="bi bi-eye-fill"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
