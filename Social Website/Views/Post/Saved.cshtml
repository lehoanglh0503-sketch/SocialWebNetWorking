@using Social_Website.Helpers
@model IEnumerable<Social_Website.Models.Post>
@{
    ViewData["Title"] = "Bài viết đã lưu";
    Layout = "_Layout";
    var currentUser = ViewBag.CurrentUser as Social_Website.Models.User;
}

<div class="row justify-content-center py-3 animate-fade-in-up">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="fw-bold text-dark mb-0">
                <i class="bi bi-bookmark-fill me-2 text-warning"></i>Bài viết đã lưu
            </h4>
            <span class="badge bg-secondary rounded-pill px-3">@Model.Count() bài viết</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div id="savedPostsContainer" class="d-flex flex-column gap-3">
                @foreach (var post in Model)
                {
                    <div class="card card-hover shadow-sm border-0 rounded-3" id="savedCard-@post.PostId">
                        <div class="card-body p-4">
                            <!-- Header bài viết -->
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <a href="/Profile/View/@post.User?.Username" class="d-flex align-items-center text-decoration-none text-dark">
                                    <img src="@post.User?.AvatarUrl" alt="@post.User?.FullName" class="avatar avatar-sm me-3" />
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">@post.User?.FullName</h6>
                                        <span class="text-muted small">@post.CreatedAt.ToVietnamTimeString()</span>
                                        @if (post.UpdatedAt != null)
                                        {
                                            <span class="text-muted small ms-1" title="Đã chỉnh sửa">(đã chỉnh sửa)</span>
                                        }
                                    </div>
                                </a>
                                <button class="btn btn-outline-danger btn-sm rounded-pill btn-unsave-post" data-post-id="@post.PostId">
                                    <i class="bi bi-bookmark-x me-1"></i>Bỏ lưu
                                </button>
                            </div>

                            <!-- Nội dung bài viết -->
                            @if (!string.IsNullOrEmpty(post.Content))
                            {
                                <p class="card-text mb-3" style="white-space: pre-wrap;">@post.Content</p>
                            }

                            <!-- Ảnh bài viết -->
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                var imgList = post.ImageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries);
                                if (imgList.Length == 1)
                                {
                                    <div class="text-center mb-3">
                                        <img src="@imgList[0]" class="img-fluid rounded shadow-sm" style="max-height: 400px; width: auto;" />
                                    </div>
                                }
                                else if (imgList.Length > 1)
                                {
                                    <div class="row g-2 mb-3">
                                        @foreach (var img in imgList)
                                        {
                                            <div class="col-@(imgList.Length == 2 ? "6" : imgList.Length == 3 ? "4" : "6")">
                                                <img src="@img" class="img-fluid rounded shadow-sm w-100" style="height: 200px; object-fit: cover;" />
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm text-center py-5 rounded-3">
                <div class="card-body">
                    <i class="bi bi-bookmark-x display-1 text-muted opacity-50 mb-3"></i>
                    <h5 class="fw-bold text-dark">Bạn chưa lưu bài viết nào</h5>
                    <p class="text-muted small">Bấm nút Lưu bài viết trên bảng tin để lưu lại các bài viết yêu thích của bạn.</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Xử lý nút Bỏ lưu bài viết
            $(document).on("click", ".btn-unsave-post", function () {
                const btn = $(this);
                const postId = btn.data("post-id");
                btn.prop("disabled", true);

                $.post("/Post/ToggleSavePost", { postId: postId }, function (res) {
                    if (res.success) {
                        $(`#savedCard-${postId}`).fadeOut(300, function () {
                            $(this).remove();
                            if ($("#savedPostsContainer .card").length === 0) {
                                location.reload();
                            }
                        });
                    } else {
                        alert(res.message);
                        btn.prop("disabled", false);
                    }
                });
            });
        });
    </script>
}
